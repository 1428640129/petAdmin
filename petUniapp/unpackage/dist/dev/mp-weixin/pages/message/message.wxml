<view class="container"><view class="header"><text class="header-title">消息</text></view><scroll-view class="message-list" scroll-y="true" refresher-enabled bindrefresherrefresh="{{d}}"><view wx:if="{{a}}" class="loading"><text>加载中...</text></view><view wx:elif="{{b}}" class="empty"><text>暂无消息</text></view><block wx:else><view wx:for="{{c}}" wx:for-item="msg" wx:key="g" class="message-item" bindtap="{{msg.h}}"><view class="message-avatar"><uni-icons wx:if="{{msg.b}}" u-i="{{msg.a}}" bind:__l="__l" u-p="{{msg.b}}"></uni-icons></view><view class="message-content"><view class="message-header-info"><text class="sender">{{msg.c}}</text><text class="time">{{msg.d}}</text></view><text class="content">{{msg.e}}</text><view wx:if="{{msg.f}}" class="unread-dot"></view></view></view></block></scroll-view><view class="send-message-section"><button class="send-message-btn" bindtap="{{e}}">发送消息</button></view><view class="tab-bar"><view class="tab-item" bindtap="{{g}}"><image class="tab-icon" src="{{f}}" mode="aspectFit"></image><text class="tab-text">首页</text></view><view class="tab-item" bindtap="{{i}}"><image class="tab-icon" src="{{h}}" mode="aspectFit"></image><text class="tab-text">我的</text></view></view></view>