<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pet.business.mapper.PetBathServiceMapper">
    
    <resultMap type="com.pet.system.domain.PetBathService" id="PetBathServiceResult">
        <id     property="serviceId"      column="service_id"      />
        <result property="serviceName"    column="service_name"    />
        <result property="serviceDesc"    column="service_desc"    />
        <result property="serviceType"    column="service_type"    />
        <result property="serviceImages"  column="service_images"  />
        <result property="duration"       column="duration"       />
        <result property="status"         column="status"         />
        <result property="sortOrder"      column="sort_order"      />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>
    
    <sql id="selectBathServiceVo">
        select service_id, service_name, service_desc, service_type, service_images, duration, status, sort_order, create_by, create_time, update_by, update_time, remark 
        from pet_bath_service
    </sql>
    
    <select id="selectBathServiceList" parameterType="com.pet.system.domain.PetBathService" resultMap="PetBathServiceResult">
        <include refid="selectBathServiceVo"/>
        <where>
            <if test="serviceName != null and serviceName != ''">
                AND service_name like concat('%', #{serviceName}, '%')
            </if>
            <if test="serviceType != null and serviceType != ''">
                AND service_type = #{serviceType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort_order, service_id
    </select>
    
    <select id="selectBathServiceById" parameterType="Long" resultMap="PetBathServiceResult">
        <include refid="selectBathServiceVo"/>
        where service_id = #{serviceId}
    </select>
    
    <select id="selectEnabledBathServiceList" resultMap="PetBathServiceResult">
        <include refid="selectBathServiceVo"/>
        where status = '0'
        order by sort_order, service_id
    </select>
    
    <insert id="insertBathService" parameterType="com.pet.system.domain.PetBathService" useGeneratedKeys="true" keyProperty="serviceId">
        insert into pet_bath_service
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="serviceName != null and serviceName != ''">service_name,</if>
            <if test="serviceDesc != null">service_desc,</if>
            <if test="serviceType != null">service_type,</if>
            <if test="serviceImages != null">service_images,</if>
            <if test="duration != null">duration,</if>
            <if test="status != null">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="serviceName != null and serviceName != ''">#{serviceName},</if>
            <if test="serviceDesc != null">#{serviceDesc},</if>
            <if test="serviceType != null">#{serviceType},</if>
            <if test="serviceImages != null">#{serviceImages},</if>
            <if test="duration != null">#{duration},</if>
            <if test="status != null">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>
    
    <update id="updateBathService" parameterType="com.pet.system.domain.PetBathService">
        update pet_bath_service
        <trim prefix="SET" suffixOverrides=",">
            <if test="serviceName != null and serviceName != ''">service_name = #{serviceName},</if>
            <if test="serviceDesc != null">service_desc = #{serviceDesc},</if>
            <if test="serviceType != null">service_type = #{serviceType},</if>
            <if test="serviceImages != null">service_images = #{serviceImages},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where service_id = #{serviceId}
    </update>
    
    <delete id="deleteBathServiceById" parameterType="Long">
        delete from pet_bath_service where service_id = #{serviceId}
    </delete>
    
    <delete id="deleteBathServiceByIds" parameterType="Long">
        delete from pet_bath_service where service_id in 
        <foreach item="serviceId" collection="array" open="(" separator="," close=")">
            #{serviceId}
        </foreach>
    </delete>
    
</mapper>

