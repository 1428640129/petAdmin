page.data-v-ef2dfbea {
  height: 100%;
  background-color: #fffdf8;
}
.container.data-v-ef2dfbea {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #fffdf8;
}
.header.data-v-ef2dfbea {
  width: 100%;
  min-height: 88rpx;
  padding-top: constant(safe-area-inset-top, 0px);
  padding-top: env(safe-area-inset-top, 0px);
  background: linear-gradient(to right, #ff8c42, #ff6b35);
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
  box-sizing: border-box;
}
.header-title.data-v-ef2dfbea {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}
.status-tabs.data-v-ef2dfbea {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx;
  margin-top: calc(88rpx + env(safe-area-inset-top, 0px));
  border-bottom: 2rpx solid #f5f5f5;
  position: -webkit-sticky;
  position: sticky;
  top: calc(88rpx + env(safe-area-inset-top, 0px));
  z-index: 999;
}
.tab-item.data-v-ef2dfbea {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-item.active.data-v-ef2dfbea {
  color: #ff6b35;
  font-weight: bold;
}
.tab-item.active.data-v-ef2dfbea::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #ff6b35;
  border-radius: 2rpx;
}
.appointment-list.data-v-ef2dfbea {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 120rpx;
  /* 为tabBar留出空间 */
}
.loading-container.data-v-ef2dfbea,
.empty-container.data-v-ef2dfbea {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
.appointment-item.data-v-ef2dfbea {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.item-header.data-v-ef2dfbea {
  display: flex;
