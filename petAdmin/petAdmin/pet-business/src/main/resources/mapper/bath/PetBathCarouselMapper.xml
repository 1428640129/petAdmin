<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pet.business.mapper.PetBathCarouselMapper">
    
    <resultMap type="com.pet.system.domain.PetBathCarousel" id="PetBathCarouselResult">
        <id     property="carouselId"      column="carousel_id"      />
        <result property="title"           column="title"           />
        <result property="imageUrl"       column="image_url"       />
        <result property="linkUrl"        column="link_url"        />
        <result property="sortOrder"      column="sort_order"      />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>
    
    <sql id="selectBathCarouselVo">
        select carousel_id, title, image_url, link_url, sort_order, status, create_by, create_time, update_by, update_time, remark 
        from pet_bath_carousel
    </sql>
    
    <select id="selectBathCarouselList" parameterType="com.pet.system.domain.PetBathCarousel" resultMap="PetBathCarouselResult">
        <include refid="selectBathCarouselVo"/>
        <where>
            <if test="title != null and title != ''">
                AND title like concat('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort_order, carousel_id
    </select>
    
    <select id="selectEnabledBathCarouselList" resultMap="PetBathCarouselResult">
        <include refid="selectBathCarouselVo"/>
        where status = '0'
        order by sort_order, carousel_id
    </select>
    
    <select id="selectBathCarouselById" parameterType="Long" resultMap="PetBathCarouselResult">
        <include refid="selectBathCarouselVo"/>
        where carousel_id = #{carouselId}
    </select>
    
    <insert id="insertBathCarousel" parameterType="com.pet.system.domain.PetBathCarousel" useGeneratedKeys="true" keyProperty="carouselId">
        insert into pet_bath_carousel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="linkUrl != null">link_url,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="linkUrl != null">#{linkUrl},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>
    
    <update id="updateBathCarousel" parameterType="com.pet.system.domain.PetBathCarousel">
        update pet_bath_carousel
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where carousel_id = #{carouselId}
    </update>
    
    <delete id="deleteBathCarouselById" parameterType="Long">
        delete from pet_bath_carousel where carousel_id = #{carouselId}
    </delete>
    
    <delete id="deleteBathCarouselByIds" parameterType="Long">
        delete from pet_bath_carousel where carousel_id in 
        <foreach item="carouselId" collection="array" open="(" separator="," close=")">
            #{carouselId}
        </foreach>
    </delete>
    
</mapper>










