<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pet.business.mapper.PetBathPaymentMapper">
    
    <resultMap type="com.pet.system.domain.PetBathPayment" id="PetBathPaymentResult">
        <id     property="paymentId"          column="payment_id"          />
        <result property="paymentNo"          column="payment_no"          />
        <result property="orderId"            column="order_id"            />
        <result property="orderNo"            column="order_no"            />
        <result property="userId"             column="user_id"             />
        <result property="paymentType"        column="payment_type"        />
        <result property="paymentAmount"      column="payment_amount"      />
        <result property="status"             column="status"              />
        <result property="transactionId"      column="transaction_id"      />
        <result property="payTime"             column="pay_time"             />
        <result property="refundTime"         column="refund_time"         />
        <result property="refundReason"        column="refund_reason"        />
        <result property="createTime"         column="create_time"          />
        <result property="updateTime"         column="update_time"          />
    </resultMap>
    
    <sql id="selectBathPaymentVo">
        select payment_id, payment_no, order_id, order_no, user_id, payment_type, payment_amount, 
               status, transaction_id, pay_time, refund_time, refund_reason, create_time, update_time 
        from pet_bath_payment
    </sql>
    
    <select id="selectBathPaymentList" parameterType="com.pet.system.domain.PetBathPayment" resultMap="PetBathPaymentResult">
        <include refid="selectBathPaymentVo"/>
        <where>
            <if test="paymentNo != null and paymentNo != ''">
                AND payment_no like concat('%', #{paymentNo}, '%')
            </if>
            <if test="orderId != null">
                AND order_id = #{orderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="paymentType != null and paymentType != ''">
                AND payment_type = #{paymentType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectBathPaymentById" parameterType="Long" resultMap="PetBathPaymentResult">
        <include refid="selectBathPaymentVo"/>
        where payment_id = #{paymentId}
    </select>
    
    <insert id="insertBathPayment" parameterType="com.pet.system.domain.PetBathPayment" useGeneratedKeys="true" keyProperty="paymentId">
        insert into pet_bath_payment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paymentNo != null and paymentNo != ''">payment_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="userId != null">user_id,</if>
            <if test="paymentType != null">payment_type,</if>
            <if test="paymentAmount != null">payment_amount,</if>
            <if test="status != null">status,</if>
            <if test="transactionId != null">transaction_id,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="refundTime != null">refund_time,</if>
            <if test="refundReason != null">refund_reason,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paymentNo != null and paymentNo != ''">#{paymentNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="paymentType != null">#{paymentType},</if>
            <if test="paymentAmount != null">#{paymentAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="transactionId != null">#{transactionId},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="refundTime != null">#{refundTime},</if>
            <if test="refundReason != null">#{refundReason},</if>
            sysdate()
        </trim>
    </insert>
    
    <update id="updateBathPayment" parameterType="com.pet.system.domain.PetBathPayment">
        update pet_bath_payment
        <trim prefix="SET" suffixOverrides=",">
            <if test="paymentNo != null and paymentNo != ''">payment_no = #{paymentNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="paymentType != null">payment_type = #{paymentType},</if>
            <if test="paymentAmount != null">payment_amount = #{paymentAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="transactionId != null">transaction_id = #{transactionId},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="refundTime != null">refund_time = #{refundTime},</if>
            <if test="refundReason != null">refund_reason = #{refundReason},</if>
            update_time = sysdate()
        </trim>
        where payment_id = #{paymentId}
    </update>
    
    <delete id="deleteBathPaymentById" parameterType="Long">
        delete from pet_bath_payment where payment_id = #{paymentId}
    </delete>
    
    <delete id="deleteBathPaymentByIds" parameterType="Long">
        delete from pet_bath_payment where payment_id in 
        <foreach item="paymentId" collection="array" open="(" separator="," close=")">
            #{paymentId}
        </foreach>
    </delete>
    
</mapper>
















